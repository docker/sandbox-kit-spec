# The kit's own files: the frontend stages the descriptor and recipe itself,
# and the context body is inline in skills.yaml rather than shipped as
# reference material on disk.
skills.yaml
skills.dockerfile

# Host-side wiring. README.md documents the `ln -s` that links this directory
# into an agent's skills path on a developer machine; an agent that read it
# inside a sandbox would try to reproduce a layout that does not exist there.
README.md

# This file. Build wiring, not reference material.
.dockerignore

.DS_Store
