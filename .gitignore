# Local build artifacts
/frontend
/kit-tck
/bin/
/dist/

# Local editor and agent settings. The skills in skills/ are tool-agnostic, so
# whatever an agent wants them under is a local choice rather than the
# repository's — see skills/README.md. Only the links that wiring recipe makes
# are ignored, so a shared agent config added later is not silently skipped.
.vscode/
.cursor/skills
.claude/skills
.claude/settings.local.json
.DS_Store

# Optional local workspace; published builds use independent modules.
/go.work
/go.work.sum
