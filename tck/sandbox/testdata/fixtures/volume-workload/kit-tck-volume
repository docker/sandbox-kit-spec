#!/bin/sh
set -eu
operation="$1"; root="$2"; name="${3:-}"; value="${4:-}"
case "$operation" in
writable) test -d "$root"; { test -w "$root" && test -x "$root"; } || exit 3 ;;
readable) test -d "$root"; { test -r "$root" && test -x "$root"; } || exit 3 ;;
write) mkdir -p "$root"; printf '%s' "$value" >"$root/$name" ;;
read) cat "$root/$name" ;;
absent) test ! -e "$root/$name" ;;
empty) test -d "$root"; test -z "$(ls -A "$root")" ;;
mounted) awk -v p="$root" '$5 == p {found=1} END {exit !found}' /proc/self/mountinfo ;;
unmounted) awk -v p="$root" '$5 == p {found=1} END {exit found}' /proc/self/mountinfo ;;
mode) stat -c '%a' "$root${name:+/$name}" ;;
set-mode) chmod "$value" "$root${name:+/$name}" ;;
*) exit 1 ;;
esac
