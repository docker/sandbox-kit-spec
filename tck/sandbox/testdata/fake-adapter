      if [ "$broken" = "ignores-http-path" ]; then exit 0; fi
      echo "refused by policy: path" >&2
      exit 7
      ;;
    *)
      echo "refused by policy" >&2
      exit 7
      ;;
    esac
    ;;
  ls)
    case "$2" in
    /home/agent/.kit-tck/skills-opt)
      if [ -d "$dir/skills-opt" ]; then ls "$dir/skills-opt"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    /home/agent/.kit-tck/skills-rw)
      if [ -d "$dir/skills-rw" ]; then ls "$dir/skills-rw"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    /home/agent/.kit-tck/skills)
      if [ -d "$dir/skills" ]; then ls "$dir/skills"; else
        echo "ls: cannot access '$2': No such file or directory" >&2
        exit 1
      fi
      ;;
    *)
      echo "unsupported path: $2" >&2
      exit 1
      ;;
    esac
    ;;
  kit-tck-write)
    case "$2" in
    /var/tmp/kit-tck-scratch)
      printf '%s' "$3" >"$dir/scratch"
      ;;
    /home/agent/.kit-tck/skills/*)
      # A co-composed readwrite declaration widens this mount, unless the
      # runtime wrongly resolves the shared path to the narrower mode.
      if [ -f "$dir/skills-shared" ] && [ "$broken" != "narrows-shared-path" ] && [ ! -f "$dir/host-skills-readonly" ]; then
        : >"$dir/skills/$(basename "$2")"
        exit 0
      fi
