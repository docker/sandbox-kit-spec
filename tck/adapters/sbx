#!/usr/bin/env bash
# An adapter that drives Docker Sandboxes — the `sbx` CLI — through the
# conformance contract in docs/spec/conformance.md:
#
#   kit-tck runtime --adapter tck/adapters/sbx   (or: task tck:runtime:sbx)
#
# Every verb maps onto a published sbx command, with two exceptions worth
# knowing before reading a report:
#
#   - `recreate` has no sbx command. It is an `sbx rm` followed by a
#     create under the same name from the arguments the first create
#     used — the closest sbx offers to replacing a container in place.
#     This ends the runtime instance, so it is not volume-conforming
#     recreation. volume@1 remains unclaimed until sbx can preserve
#     instance-owned storage without removing the instance.
#   - `capabilities` is a claim, not a discovery: sbx has no command that
#     reports which capability types it implements, so the list lives
#     here. Claiming one sbx does not implement produces failures rather
#     than silence, which is the direction the default errs in.
#
# Environment:
#   SBX                          the CLI to drive (default: sbx)
#   SBX_TCK_CAPABILITIES         comma- or newline-separated claim list,
#                                replacing the default below
#   SBX_TCK_APP_NAME             --app-name for every call, which moves
#                                sandboxes, the skills store, secrets and
#                                policy onto state of their own. Needs its
#                                own `sbx --app-name <name> login`, and is
#                                required for missing/empty skills-store probes
#                                and when credential@1 is claimed —
#                                which also passes the fixture's secret
#                                through sbx's argv, since set-custom
#                                takes no protected input.
#   SBX_TCK_STATE                where the adapter remembers each
#                                sandbox's create arguments, for recreate.
#                                It has to be a directory only this user
#                                can write: cleanup acts on what it says.
#   SBX_TCK_REFUSAL_PATTERN      extended regex deciding which failures
#                                are deliberate refusals (exit 2)
#   SBX_TCK_SHARE_SKILLS_STORE   seed the marker skill into a store that
#                                already holds skills of its own. Only an
#                                entry this run created is removed with
#                                the last sandbox; one that was already
#                                there is left as it was found.
set -euo pipefail

sbx_bin="${SBX:-sbx}"
state="${SBX_TCK_STATE:-${TMPDIR:-/tmp}/kit-tck-sbx-$(id -u)${SBX_TCK_APP_NAME:+-$SBX_TCK_APP_NAME}}"

# The line seeding writes into the marker's SKILL.md, and cleanup looks
# for before removing anything: a directory that does not carry it is
# somebody else's skill under the same name.
marker_line="Placed by tck/adapters/sbx"

# What this runtime claims to implement. A partial implementation is
# conforming for what it claims, so the honest list is the one whose
# checks sbx can actually answer:
#
#   credential@1 is absent because binding the fixture's `kit-tck`
#   service means storing a secret sbx has no built-in service for, and
#   §2.3 says an adapter that cannot bind credentials should not claim
#   the type rather than fail its checks. bind_credential below does the
#   binding on a best-effort basis, so adding the type here is enough to
#   try it — under SBX_TCK_APP_NAME, because the secret is a real one in
#   a real store and the default installation's is not the run's to
#   write.
#
#   volume@1 is absent because sbx mounts nothing at a declared volume
#   path: the fixture asks for /data, the sandbox has no such mount, and
#   a write there fails outright — so no observation about persistence
#   can be made at all. Claiming this type also requires an in-place
#   recreation operation and volume-paths observation of retained storage;
#   a same-name remove/create cannot preserve instance identity.
#
#   port@1, usb-device@1, agent-sessions@1, agent-interactive-sessions@1
#   and kit-registry@1 are absent because the contract gives the suite no
#   host-side observation for them; they are skipped either way, and
#   claiming a type nothing can judge states more than a report can
#   support.
#
#   ssh-agent@1 is present because a v3 kit set reaches the host agent
#   only through its grant: the daemon decides the phase grants at
#   create, filters the relay to listing/signing/session-bind, and
#   refuses a required grant when no backing agent is available. create
#   accepts --ssh-agent as the suite's socket (exported as SSH_AUTH_SOCK
#   for sbx's client-socket path) and --ssh-known-hosts as the host keys
#   authenticate destinations are matched against.
#
#   git-identity@1 is present because a v3 kit set receives the runtime
#   author identity only when it asks: pinned at create, kept across
#   restart/recreate while the set still requests it, and refused when
#   a required grant has no usable pair. create accepts
#   --git-identity-config as the suite-owned binding (or off). The
#   adapter retains create-time selected/skipped records (and an empty
#   surface when a partially supported optional group is skipped): sbx
#   inspect does not yet expose retained selection, so `selection`
#   returns that retained decision rather than reselecting.
#
#   sbx@1 is present for the opposite reason of the absences above: it
#   is the platform contract this runtime is named for, so a duty it
#   does not meet is a finding worth reading rather than a type to pass
#   over.
default_capabilities="\
com.docker.sandbox/sbx@1
com.docker.sandbox/lifecycle@1
com.docker.sandbox/network-policy@1
com.docker.sandbox/network-policy@2
com.docker.sandbox/agent-context@1
com.docker.sandbox/agent-skills@1
com.docker.sandbox/resources@1
com.docker.sandbox/privileged@1
com.docker.sandbox/ssh-agent@1
com.docker.sandbox/git-identity@1"

# Which failures are refusals. The distinction is load-bearing: several
# requirements are satisfied only by refusing something, and an adapter
# that called every non-zero status a refusal would satisfy them all
# while being unable to create a sandbox at all. sbx reports a policy
# decision and a breakage the same way — a non-zero status and an ERROR
# line — so the difference has to be read out of the message. Every
# token below is one sbx emits; a phrase it never prints would be dead
# weight at best, and at worst would grow into one it does print for a
# breakage.
#
# The daemon draws the distinction itself where it answers over HTTP: a
# request it understood and declined comes back 400, and one that broke
# on the way comes back 500 — an unsupported required capability is the
# former, a hook that could not write its file is the latter. The remaining patterns are the CLI's own refusals, which
# never reach the daemon. All of them are narrow on purpose: a refusal
# reported as an error fails a check loudly, while an error reported as a
# refusal passes one quietly.
refusal_pattern="${SBX_TCK_REFUSAL_PATTERN:-\
request failed: 400|\
does not support|\
does not implement|\
exceeds the number of available CPUs|\
requires com\\.docker\\.sandbox/ssh-agent@1|\
requires com\\.docker\\.sandbox/git-identity@1|\
no SSH agent is available|\
no git user\\.name}"

# The suite hands the adapter a HOME that reaches the real one through a
# sentinel-named symlink (§2.3), so a runtime copying the value into a
# hook betrays where it came from. sbx cannot be driven through it: its
# daemon socket lives under HOME, and the extra path components push that
# socket past the 104-byte sun_path limit, so every call tries to start a
# second daemon instead of talking to the running one. The physical path
# is what sbx gets.
#
# The cost, stated where a reader of the report will find it: a runtime
# that copies the host's HOME into a hook environment leaks an unmarked
# path, which lifecycle@1/hook-env-restricted then cannot attribute to
# the host. Every other decorated value still carries the sentinel —
# KIT_TCK_HOST_SENTINEL itself, TERM, HOSTNAME, SHLVL, OLDPWD, _, the
# PATH component, and PWD, which this leaves alone.
real_home="$(cd -P "${HOME:-/}" 2>/dev/null && pwd -P)" || real_home="${HOME:-}"

# Every call carries --app-name when one is configured, so an isolated
# run cannot reach the sandboxes, secrets, skills or policy of the
# default installation.
run_sbx() {
	if [ -n "${SBX_TCK_APP_NAME:-}" ]; then
		HOME="$real_home" command "$sbx_bin" --app-name "$SBX_TCK_APP_NAME" "$@"
	else
		HOME="$real_home" command "$sbx_bin" "$@"
	fi
}

die() {
	echo "sbx-adapter: $*" >&2
	exit 1
}

# An exact claim rather than a substring: a narrowed or custom list must
# not arrange host state for a type it does not name, and
# `not-agent-skills@1` or `agent-skills@10` contain one that it does.
claims() {
	local list
	# Captured, not piped: grep -q stops reading at the first match, and
	# under pipefail the producer's SIGPIPE would come back as no match.
	list="$(capabilities)"
	grep -qxF "$1" <<<"$list"
}

# stat's spellings differ between the GNU and BSD tools. GNU first,
# because GNU stat reads -f as "report on the filesystem" and succeeds:
# the BSD spelling tried first would return a filesystem report here
# rather than failing over.
stat_owner() { stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1"; }
stat_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"; }

# The adapter reads cleanup targets out of this directory and acts on
# them, so a directory anyone else can write is a way to aim a removal.
# Checked rather than assumed, because the default path is predictable.
prepare_state() {
	if [ ! -d "$state" ]; then
		mkdir -p "$(dirname "$state")"
		mkdir -m 700 "$state"
	fi
	[ ! -L "$state" ] || die "$state is a symlink; the adapter's state has to be a directory it owns"
	[ "$(stat_owner "$state")" = "$(id -u)" ] ||
		die "$state belongs to another user; set SBX_TCK_STATE to a directory of this one's"
	[ "$(stat_mode "$state")" = 700 ] ||
		die "$state is writable beyond its owner; the adapter acts on what this directory says"
}

# Host state the adapter created, taken back once the last sandbox it
# holds is gone. Only what seeding recorded, and only while it still
# looks like what seeding wrote — a skill a user installed is never the
# adapter's to remove.
release_host_state() {
	if ls "$state"/*.create >/dev/null 2>&1; then
		return 0
	fi
	restore_skill_store
	if [ -f "$state/seeded-skill" ]; then
		local name store
		name="$(cat "$state/seeded-skill")"
		# Explicitly, because under set -e a failing skills_store would
		# end cleanup here: the marker would go unmentioned, the
		# credential unremoved, and rm would report a failure for a
		# sandbox that is already gone.
		store="$(skills_store 2>/dev/null)" || store=""
		case "$name" in
		"" | . | .. | */*)
			# Nothing seeding could have written, so nothing to take
			# back and nothing to remember.
			rm -f "$state/seeded-skill"
			;;
		*)
			if [ -z "$store" ]; then
				echo "sbx-adapter: could not resolve the skills store; the marker skill $name outlived the run" >&2
			elif ! only_seeded_marker "$store/$name" "$name"; then
				# Already gone, or no longer exactly what seeding wrote:
				# an edited skill belongs to whoever edited it.
				rm -f "$state/seeded-skill"
			elif rm -rf "${store:?}/${name:?}"; then
				rm -f "$state/seeded-skill"
			else
				echo "sbx-adapter: the marker skill $store/$name outlived the run; remove it by hand" >&2
			fi
			;;
		esac
	fi
	# A binding the adapter stranded is remembered until a person takes
	# it out, and said again every time cleanup runs. Remembered rather
	# than retried: the removal already failed once, and by the next
	# attempt the name could hold a binding someone repaired or replaced,
	# which nothing here can tell from this one.
	if [ -f "$state/stranded-credential" ]; then
		echo "sbx-adapter: a kit-tck binding an earlier run could not remove is still in the store; 'sbx secret rm kit-tck' takes it out, then delete $state/stranded-credential" >&2
	fi
	if [ -f "$state/bound-credential" ]; then
		if run_sbx secret rm kit-tck -f >/dev/null 2>&1; then
			rm -f "$state/bound-credential"
		else
			mv -f "$state/bound-credential" "$state/stranded-credential"
			echo "sbx-adapter: the kit-tck credential outlived the run; 'sbx secret rm kit-tck' takes it out, then delete $state/stranded-credential" >&2
		fi
	fi
}

# The host's shared skills store, as sbx itself resolves it: the path is
# app-scoped and platform-specific, and asking is the only way to seed
# the store the sandbox will actually be given.
skills_store() {
	run_sbx skills ls --json | sed -n 's/.*"store"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
}

# Missing/empty probes need sharing enabled. Move the isolated app's store
# aside until cleanup, so the scenario neither deletes existing skills nor
# substitutes the runtime's off setting for an absent directory.
prepare_skill_store() {
	local scenario="$1" store
	[ ! -f "$state/skills-store.path" ] ||
		die "a skills-store probe is still active; remove its sandbox before another create"
	if [ -z "$scenario" ]; then
		seed_skill_store
		return
	fi
	case "$scenario" in
	missing | empty) ;;
	*) die "unknown skills-store scenario: $scenario" ;;
	esac
	[ -n "${SBX_TCK_APP_NAME:-}" ] ||
		die "missing/empty skills-store probes require SBX_TCK_APP_NAME for isolated host state"
	if ls "$state"/*.create >/dev/null 2>&1; then
		die "skills-store probes cannot replace a store used by another sandbox"
	fi
	store="$(skills_store)"
	case "$store" in
	/*) [ "$store" != / ] || die "invalid skills-store path: $store" ;;
	*) die "could not resolve an absolute skills-store path" ;;
	esac
	[ ! -L "$store" ] || die "skills-store probes do not replace symlinks"
	[ ! -e "$state/skills-store.backup" ] || die "a saved skills store still needs recovery"
	if [ -e "$store" ]; then
		[ -d "$store" ] || die "skills store is not a directory: $store"
		mv "$store" "$state/skills-store.backup"
	fi
	printf '%s\n' "$store" >"$state/skills-store.path"
	if [ "$scenario" = empty ]; then
		mkdir -p "$store"
	fi
}

restore_skill_store() {
	[ -f "$state/skills-store.path" ] || return 0
	local store
	store="$(cat "$state/skills-store.path")"
	# Only an empty probe directory is disposable. Unexpected content stays
	# put with the backup, rather than being erased to make restoration pass.
	[ ! -L "$store" ] || die "probe store became a symlink; saved store retained in $state"
	if [ -e "$store" ]; then
		rmdir "$store" || die "probe store is not empty; saved store retained in $state"
	fi
	if [ -d "$state/skills-store.backup" ]; then
		mv "$state/skills-store.backup" "$store"
	fi
	rm -f "$state/skills-store.path"
}

# §2.3 requires a known entry in the store before agent-skills@1 is
# claimed: the capability permits no mount when the store is empty, so
# without a marker the suite cannot tell a mounted store from an empty
# directory. Written directly rather than through `sbx skills add`, which
# installs from a git repository.
seed_skill_store() {
	local name="${KIT_TCK_SKILL_NAME:-}" store
	[ -n "$name" ] || return 0
	# The suite arranges the known values whatever a runtime claims, so
	# the claim is what decides whether the store is touched at all: a
	# run that narrowed its claims has no skills checks to answer and no
	# business writing to a store on their behalf.
	claims com.docker.sandbox/agent-skills@1 || return 0
	store="$(skills_store)"
	[ -n "$store" ] || die "could not resolve the skills store from 'sbx skills ls --json'"

	# §2.3 also says a runtime should not point these fixtures at a store
	# a user depends on. Seeding a store that holds someone's skills is
	# that, so it takes saying so — SBX_TCK_APP_NAME is the way to get a
	# store of one's own.
	if [ -z "${SBX_TCK_SHARE_SKILLS_STORE:-}" ] && [ -d "$store" ]; then
		local entry
		for entry in "$store"/*; do
			[ -d "$entry" ] || continue
			case "${entry##*/}" in
			"$name") ;;
			*) die "the skills store $store already holds $(basename "$entry"); run under SBX_TCK_APP_NAME for a store of its own, or set SBX_TCK_SHARE_SKILLS_STORE=1 to seed this one" ;;
			esac
		done
	fi

	# mkdir without -p is the claim: it succeeds only if this run created
	# the entry, so an entry that was already there is left as it was
	# found and never recorded as the adapter's to remove.
	mkdir -p "$store"
	if ! mkdir "$store/$name" 2>/dev/null; then
		# Already there is fine and stays untouched; anything else is
		# this run failing to arrange what its claim promises.
		[ -d "$store/$name" ] ||
			die "could not create the marker skill at $store/$name"
		return 0
	fi
	if ! marker_body "$name" >"$store/$name/SKILL.md"; then
		rm -rf "${store:?}/${name:?}"
		die "could not write the marker skill at $store/$name"
	fi
	# Recorded once it exists, and by name: cleanup resolves the store
	# again rather than following a path out of a file into somewhere
	# else.
	printf '%s\n' "$name" >"$state/seeded-skill"
}

# Whether a marker directory still holds exactly what seeding wrote: one
# SKILL.md with that body and nothing beside it. A support file someone
# added is as much theirs as an edit to the body.
only_seeded_marker() {
	local dir="$1" name="$2" entries
	entries="$(find "$dir" -mindepth 1 2>/dev/null)" || return 1
	[ "$entries" = "$dir/SKILL.md" ] || return 1
	marker_body "$name" | diff -q - "$dir/SKILL.md" >/dev/null 2>&1
}

# What seeding writes, and what cleanup expects to find unchanged.
marker_body() {
	cat <<EOF
---
name: $1
description: Marker skill the conformance suite looks for in the shared store
---

$marker_line so a mounted store is distinguishable from an
empty one. Safe to delete.
EOF
}

# §2.3 requires the fixture credential service's secret to be bound on the
# host, and the sandbox to see a sentinel rather than the value. sbx has
# no built-in `kit-tck` service, so this is a custom secret: the env name
# is the one the fixture declares, and the host is the one its network
# policy allows. Best effort by design — the type is unclaimed by default,
# and a runtime that cannot bind credentials should not claim it.
# What has to hold before anything is written to the host. Checked first
# because seeding leaves state behind, and a die after that would leave
# it with nothing to take it back.
check_prerequisites() {
	if [ -n "${KIT_TCK_BOUND_SECRET:-}" ] && claims com.docker.sandbox/credential@1; then
		# Binding writes a real secret into a real store under a name a
		# user may keep one under. An app of its own is what makes that
		# the suite's business rather than the default installation's.
		[ -n "${SBX_TCK_APP_NAME:-}" ] ||
			die "credential@1 binds the fixture's secret into the app's secret store; run under SBX_TCK_APP_NAME so the default installation's is left alone"
	fi
}

bind_credential() {
	local secret="${KIT_TCK_BOUND_SECRET:-}"
	[ -n "$secret" ] || return 0
	claims com.docker.sandbox/credential@1 || return 0
	local bound
	# Captured for the same reason claims() is: a short-circuiting grep
	# can leave the producer on a SIGPIPE that pipefail reads as no
	# match, and this one decides whether a real secret is replaced.
	if ! bound="$(run_sbx secret ls --json 2>/dev/null)"; then
		# Fail closed: a listing that could not be read says nothing
		# about what is in the store, and this is the only thing
		# standing between the fixture's secret and a binding of the
		# user's.
		echo "sbx-adapter: could not list secrets, so the kit-tck binding is left alone; its checks will report what the sandbox saw" >&2
		return 0
	fi
	if grep -q '"kit-tck"' <<<"$bound"; then
		echo "sbx-adapter: a kit-tck secret is already bound; leaving it, and its checks will report what the sandbox saw" >&2
		return 0
	fi
	# example.com is the host the fixture's credential injects into at
	# runtime, and binding any other one would present the sandbox a
	# sentinel the proxy never substitutes.
	#
	# --value puts the secret in sbx's argv, where a process of this
	# user's can read it while the command runs. set-custom offers no
	# protected input — --token carries the same warning, and --command
	# is re-run by the daemon, which does not have the suite's
	# environment — so the exposure is stated rather than hidden: this is
	# the suite's throwaway fixture value, and credential@1 stays
	# unclaimed by default.
	if run_sbx secret set-custom \
		--name kit-tck \
		--host example.com \
		--env KIT_TCK_TOKEN \
		--value "$secret" >/dev/null 2>&1; then
		# Remembered for the same reason the marker skill is: the
		# binding is the run's, and the store should hold what it held
		# before once the last sandbox is gone.
		: >"$state/bound-credential"
	else
		echo "sbx-adapter: binding the kit-tck credential failed; its checks will report what the sandbox saw" >&2
	fi
}

capabilities() {
	# Unset takes the default; set-and-empty is a runtime claiming
	# nothing, which the contract allows and :- could not express.
	printf '%s\n' "${SBX_TCK_CAPABILITIES-$default_capabilities}" | tr ',' '\n' |
		sed '/^[[:space:]]*$/d;s/^[[:space:]]*//;s/[[:space:]]*$//'
}

# §2.5 leaves the reference form to the runtime, and sbx reads a bare
# relative path as a repository on Docker Hub — a local kit has to say so
# with ./ or an absolute path. The suite resolves its fixture root
# absolutely, so this only matters for a hand-typed run, where being
# silently sent to a registry is a confusing way to learn the rule.
kit_reference() {
	case "$1" in
	/* | ./* | ../*) printf '%s\n' "$1" ;;
	*)
		if [ -e "$1" ]; then printf './%s\n' "$1"; else printf '%s\n' "$1"; fi
		;;
	esac
}

# Whether the daemon positively says a sandbox is not there. A listing it
# could not produce is not an answer: unreachable is unknown, and unknown
# is not absent.
absent() {
	local listing
	listing="$(run_sbx ls --json 2>/dev/null)" || return 1
	! grep -qF "\"$1\"" <<<"$listing"
}

# A name sbx accepts (letters, digits, hyphens) that says where it came
# from, so a sandbox the suite could not remove is recognizable on sight.
new_id() {
	printf 'kit-tck-%s\n' "$(od -An -tx1 -N5 /dev/urandom | tr -d ' \n')"
}

# One selection record for an ordinary (non-group) capability entry at
# capabilities[0], optionally with a rejected member path when skipped.
selection_record() {
	local kit="$1" rejected="${2:-}"
	if [ -n "$rejected" ]; then
		printf '{"path":"capabilities[0]","source":{"kit":"%s","path":"capabilities[0]"},"members":["capabilities[0]"],"memberSources":[{"kit":"%s","path":"capabilities[0]"}],"rejected":["%s"]}' \
			"$kit" "$kit" "$rejected"
	else
		printf '{"path":"capabilities[0]","source":{"kit":"%s","path":"capabilities[0]"},"members":["capabilities[0]"],"memberSources":[{"kit":"%s","path":"capabilities[0]"}]}' \
			"$kit" "$kit"
	fi
}

# Skipped optional group whose members could not all be granted. Surface
# stays empty: no member grant may leak when the group is skipped.
group_skip_record() {
	local kit="$1" rejected="$2"
	printf '{"path":"capabilities[0]","source":{"kit":"%s","path":"capabilities[0]"},"members":["capabilities[0].group.capabilities[0]","capabilities[0].group.capabilities[1]"],"rejected":["%s"]}' \
		"$kit" "$rejected"
}

# Whether this runtime can grant volume@1 / lifecycle@1. volume@1 is
# absent from the default claim list (sbx mounts nothing at a declared
# volume path); lifecycle@1 is present, but an override may drop it.
claims_volume() {
	claims com.docker.sandbox/volume@1
}
claims_lifecycle() {
	claims com.docker.sandbox/lifecycle@1
}

# An optional volume+lifecycle group is withheld from sbx when any member
# is unavailable (unclaimed or rejected), so a partially supported group
# cannot apply its lifecycle file. The kit still appears in
# retain_selection as skipped.
omit_unsatisfiable_group_kit() {
	local base
	base="$(basename "$1")"
	case "$base" in
	groups-partial)
		if ! claims_volume || ! claims_lifecycle ||
			rejected_capability com.docker.sandbox/volume@1 ||
			rejected_capability com.docker.sandbox/lifecycle@1; then
			return 0
		fi
		return 1
		;;
	*)
		return 1
		;;
	esac
}

# Whether the suite arranged a false selection answer for this type.
rejected_capability() {
	local typ="$1" entry
	for entry in "${rejects[@]+"${rejects[@]}"}"; do
		[ "$entry" = "$typ" ] && return 0
	done
	return 1
}

# Omit an optional fixture kit from the sbx create when the suite rejected
# its type. The kit still participates in retain_selection as skipped.
omit_rejected_optional_kit() {
	local base
	base="$(basename "$1")"
	case "$base" in
	ordinary-optional)
		rejected_capability com.docker.sandbox/lifecycle@1
		;;
	git-identity-optional)
		rejected_capability com.docker.sandbox/git-identity@1
		;;
	skills-optional)
		rejected_capability com.docker.sandbox/agent-skills@1
		;;
	ssh-agent-optional)
		rejected_capability com.docker.sandbox/ssh-agent@1
		;;
	*)
		return 1
		;;
	esac
}

# Refuse a required fixture entry the suite arranged as unavailable, or a
# required group whose members this claim list cannot all grant.
# Fixture basenames match the suite's kit directories; the messages name
# the capability so refusal classification can spot them.
refuse_rejected_required() {
	local kit base
	for kit in "$@"; do
		base="$(basename "$kit")"
		case "$base" in
		ordinary-required | git-identity | skills | ssh-agent | ssh-agent-install | ssh-agent-bounded | ssh-agent-dual)
			if rejected_capability com.docker.sandbox/lifecycle@1 && [ "$base" = ordinary-required ]; then
				echo "refusing: $base capabilities[0]: rejected com.docker.sandbox/lifecycle@1" >&2
				exit 2
			fi
			if rejected_capability com.docker.sandbox/git-identity@1 && [ "$base" = git-identity ]; then
				echo "refusing: $base capabilities[0]: rejected com.docker.sandbox/git-identity@1" >&2
				exit 2
			fi
			if rejected_capability com.docker.sandbox/agent-skills@1 && [ "$base" = skills ]; then
				echo "refusing: $base capabilities[0]: rejected com.docker.sandbox/agent-skills@1" >&2
				exit 2
			fi
			if rejected_capability com.docker.sandbox/ssh-agent@1 && [[ "$base" == ssh-agent* ]]; then
				echo "refusing: $base capabilities[0]: rejected com.docker.sandbox/ssh-agent@1" >&2
				exit 2
			fi
			;;
		groups-required)
			# Partial support: identify the member this runtime cannot grant.
			if ! claims_volume; then
				echo "refusing: groups-required capabilities[0].group.capabilities[0]: unclaimed com.docker.sandbox/volume@1" >&2
				exit 2
			fi
			if rejected_capability com.docker.sandbox/volume@1; then
				echo "refusing: groups-required capabilities[0].group.capabilities[0]: rejected com.docker.sandbox/volume@1" >&2
				exit 2
			fi
			if ! claims_lifecycle; then
				echo "refusing: groups-required capabilities[0].group.capabilities[1]: unclaimed com.docker.sandbox/lifecycle@1" >&2
				exit 2
			fi
			if rejected_capability com.docker.sandbox/lifecycle@1; then
				echo "refusing: groups-required capabilities[0].group.capabilities[1]: rejected com.docker.sandbox/lifecycle@1" >&2
				exit 2
			fi
			;;
		esac
	done
}

# Drop create argv pairs the current rejects omit: identity/known-hosts
# when those types are rejected, and --kit mixins for optional fixtures.
# Remembered argv always places mixins under --kit; the sandbox kit stays.
filter_argv_for_rejects() {
	local -a out=()
	local arg next
	while [ $# -gt 0 ]; do
		arg="$1"
		next="${2:-}"
		case "$arg" in
		--git-identity-config)
			if rejected_capability com.docker.sandbox/git-identity@1; then
				shift 2
				continue
			fi
			out+=("$arg" "$next")
			shift 2
			;;
		--ssh-known-hosts)
			if rejected_capability com.docker.sandbox/ssh-agent@1; then
				shift 2
				continue
			fi
			out+=("$arg" "$next")
			shift 2
			;;
		--kit)
			if omit_rejected_optional_kit "$next" || omit_unsatisfiable_group_kit "$next"; then
				shift 2
				continue
			fi
			out+=("$arg" "$next")
			shift 2
			;;
		--name | --skills | --pull | --kit-arg | --env)
			out+=("$arg" "$next")
			shift 2
			;;
		*)
			out+=("$arg")
			shift
			;;
		esac
	done
	printf '%s\0' ${out[@]+"${out[@]}"}
}

# Snapshot a usable identity binding into adapter-owned state so recreate
# cannot pick up suite edits to the original --git-identity-config file.
# Prints the path (or off) to pass to sbx create / retain_selection.
snapshot_git_identity() {
	local id="$1" config="$2" name="" email="" snap
	if [ -z "$config" ]; then
		return 0
	fi
	if [ "$config" = off ]; then
		printf 'off\n' >"$state/$id.git-identity-config"
		printf 'off\n'
		return 0
	fi
	# NUL-delimited reads preserve newlines in the values; command
	# substitution would strip trailing newlines from the selected pair.
	IFS= read -r -d '' name < <(git config --file "$config" --null --get user.name 2>/dev/null) || true
	IFS= read -r -d '' email < <(git config --file "$config" --null --get user.email 2>/dev/null) || true
	if [ -n "$name" ] && [ -n "$email" ]; then
		snap="$state/$id.git-identity-snapshot"
		# Git's writer escapes quotes, backslashes, tabs and newlines as
		# config data without importing unrelated source settings.
		git config --file "$snap" user.name "$name" || return
		git config --file "$snap" user.email "$email" || return
		printf '%s\n' "$snap" >"$state/$id.git-identity-config"
		printf '%s\n' "$snap"
		return 0
	fi
	# Incomplete: keep the suite path so create can refuse or skip.
	printf '%s\n' "$config" >"$state/$id.git-identity-config"
	printf '%s\n' "$config"
}

# Retain the create-time selection the suite's `selection` verb reads.
# sbx inspect does not yet expose retained selected/skipped records or an
# effective surface, so the adapter records the decision it arranged for
# this create (which kits and grants reached sbx, which rejects applied)
# and `selection` returns that file unchanged — it does not reselect.
#
# ssh_agent is the suite-offered socket path (empty when none); rejection
# and absence both skip an optional ssh-agent entry.
retain_selection() {
	local id="$1" identity_config="$2" skills_mode="$3" skills_store="$4" ssh_agent="$5"
	shift 5
	local kits=("$@")
	local selected=() skipped=() kit base identity_name="" identity_email=""
	local identity_required="" identity_optional="" identity_requested=""
	local required_skills="" optional_skills=""
	local bundle_optional="" bundle_reader=""
	local ordinary_optional="" groups_partial=""
	local ssh_optional="" ssh_required_kit=""
	local surface='{}'
	# Host skills mode/store narrow access; they do not skip the destination
	# record. Accepted so recreate can pass the same create-time inputs.
	: "$skills_mode" "$skills_store"

	for kit in "${kits[@]}"; do
		base="$(basename "$kit")"
		case "$base" in
		git-identity) identity_required=1; identity_requested=1 ;;
		git-identity-optional) identity_optional=1; identity_requested=1 ;;
		skills) required_skills=1 ;;
		skills-optional) optional_skills=1 ;;
		bundled-optional) bundle_optional=1 ;;
		bundled-reader) bundle_reader=1 ;;
		ordinary-optional) ordinary_optional=1 ;;
		groups-partial) groups_partial=1 ;;
		ssh-agent-optional) ssh_optional=1 ;;
		ssh-agent | ssh-agent-install | ssh-agent-bounded | ssh-agent-dual)
			[ -n "$ssh_required_kit" ] || ssh_required_kit="$base"
			;;
		workload)
			if claims com.docker.sandbox/agent-context@1; then
				selected+=("$(selection_record workload)")
			fi
			;;
		esac
	done

	if [ -n "$ordinary_optional" ]; then
		if rejected_capability com.docker.sandbox/lifecycle@1; then
			skipped+=("$(selection_record ordinary-optional capabilities[0])")
		else
			selected+=("$(selection_record ordinary-optional)")
		fi
	fi

	# Optional volume+lifecycle group: any unavailable member skips the
	# whole group with no surface leak (atomicSelection / groups-partial).
	# Prefer the unclaimed/rejected member the suite's claim matrix names.
	if [ -n "$groups_partial" ]; then
		local rejected_member=""
		if ! claims_volume || rejected_capability com.docker.sandbox/volume@1; then
			rejected_member='capabilities[0].group.capabilities[0]'
		elif ! claims_lifecycle || rejected_capability com.docker.sandbox/lifecycle@1; then
			rejected_member='capabilities[0].group.capabilities[1]'
		fi
		if [ -n "$rejected_member" ]; then
			skipped+=("$(group_skip_record groups-partial "$rejected_member")")
			surface='{}'
		fi
	fi

	if rejected_capability com.docker.sandbox/git-identity@1; then
		if [ -n "$identity_optional" ]; then
			skipped+=("$(selection_record git-identity-optional capabilities[0])")
			identity_requested=""
		fi
	fi
	if [ -n "$identity_config" ] && [ "$identity_config" != off ]; then
		identity_name="$(git config --file "$identity_config" --get user.name 2>/dev/null || true)"
		identity_email="$(git config --file "$identity_config" --get user.email 2>/dev/null || true)"
	fi
	if [ -n "$identity_requested" ] && { [ -z "$identity_name" ] || [ -z "$identity_email" ]; }; then
		if [ -n "$identity_optional" ]; then
			skipped+=("$(selection_record git-identity-optional capabilities[0])")
		elif [ -n "$identity_required" ]; then
			# Required unavailable refuses create before we retain anything.
			:
		fi
	elif [ -n "$identity_requested" ]; then
		if [ -n "$identity_required" ]; then
			selected+=("$(selection_record git-identity)")
		elif [ -n "$identity_optional" ]; then
			selected+=("$(selection_record git-identity-optional)")
		fi
	fi

	# Host skills off / missing / empty still leave the destination selected:
	# access is narrowed, the discovery path is not skipped (§2.3). A
	# rejected optional skills entry is skipped instead.
	if [ -n "$required_skills" ]; then
		if rejected_capability com.docker.sandbox/agent-skills@1; then
			:
		else
			selected+=("$(selection_record skills)")
		fi
	fi
	if [ -n "$optional_skills" ]; then
		if rejected_capability com.docker.sandbox/agent-skills@1; then
			skipped+=("$(selection_record skills-optional capabilities[0])")
		else
			selected+=("$(selection_record skills-optional)")
		fi
	fi
	# A bundled skill with no discovery destination is skipped, not selected.
	if [ -n "$bundle_optional" ] && [ -z "$bundle_reader" ]; then
		skipped+=("$(selection_record bundled-optional capabilities[0])")
	fi

	# Optional ssh-agent@1: no suite socket or a rejected type skips the
	# entry (SPEC-v3 §7.1.1). Required fixtures that reached retain already
	# passed refuse_rejected_required / the no-agent create refusal.
	if [ -n "$ssh_optional" ]; then
		if rejected_capability com.docker.sandbox/ssh-agent@1 || [ -z "$ssh_agent" ]; then
			skipped+=("$(selection_record ssh-agent-optional capabilities[0])")
		else
			selected+=("$(selection_record ssh-agent-optional)")
		fi
	elif [ -n "$ssh_required_kit" ]; then
		selected+=("$(selection_record "$ssh_required_kit")")
	fi

	local selected_json="[]" skipped_json="[]" IFS=,
	if [ "${#selected[@]}" -gt 0 ]; then selected_json="[${selected[*]}]"; fi
	if [ "${#skipped[@]}" -gt 0 ]; then skipped_json="[${skipped[*]}]"; fi
	printf '{"selection":{"selected":%s,"skipped":%s},"surface":%s}\n' \
		"$selected_json" "$skipped_json" "$surface" >"$state/$id.selection.json"
}

# One create, from the argument list a later recreate can replay. The
# refusal classification lives here because create is where policy
# decisions happen: an unsatisfiable requirement, a capability the
# runtime declines, a host setting that withholds what a kit requires.
create_sandbox() {
	local id="$1"
	shift
	local output status
	set +e
	output="$(run_sbx "$@" 2>&1)"
	status=$?
	set -e
	# sbx narrates a create on stdout; only the id belongs there, so the
	# narration goes where diagnostics go.
	printf '%s\n' "$output" >&2
	if [ "$status" -ne 0 ]; then
		# A non-zero create is not proof that nothing was created: the
		# daemon may have made the sandbox and the CLI failed after it.
		# The name is the adapter's own, so asking for its removal
		# cannot reach anything of the user's.
		if run_sbx rm --force "$id" >/dev/null 2>&1 || absent "$id"; then
			# §2.4 has the suite address only the ids create returned, so
			# a create that returned none leaves nothing to recreate or
			# remove and its bookkeeping goes with it.
			rm -f "$state/$id.create" "$state/$id.ssh-agent" \
				"$state/$id.kits" "$state/$id.git-identity-config" \
				"$state/$id.git-identity-snapshot" \
				"$state/$id.skills-mode" "$state/$id.skills-store" \
				"$state/$id.selection.json" "$state/$id.selection-policy"
			# No id means no cleanup callback, so what this create
			# arranged on the host has to be taken back here or not at
			# all.
			release_host_state
		else
			# Neither removed nor known to be gone — a daemon that
			# cannot answer says nothing about whether the sandbox is
			# there. The record stays with it, and so does the host
			# state it may still be reading.
			echo "sbx-adapter: $id survived a failed create and could not be removed; its record and the host state it may be using are left in place" >&2
		fi
		if grep -Eqi "$refusal_pattern" <<<"$output"; then
			exit 2
		fi
		# Exit 2 is the contract's word for a refusal, so passing sbx's
		# own 2 through would report one where nothing was refused, and
		# every requirement satisfied by refusing something would be
		# satisfied by this breakage instead. An unclassified failure is
		# a failure, whatever number it arrived as.
		if [ "$status" -eq 2 ]; then
			status=1
		fi
		exit "$status"
	fi
	printf '%s\n' "$id"
}

verb="${1:-}"
shift || true

case "$verb" in
capabilities)
	capabilities
	;;

create)
	# Only the verbs that keep records need one.
	prepare_state
	kits=()
	requested_name=""
	kit_args=()
	container_env_args=()
	skills_mode=""
	skills_store_scenario=""
	ssh_agent=""
	ssh_known_hosts=""
	git_identity_config=""
	rejects=()
	while [ $# -gt 0 ]; do
		case "$1" in
		--name)
			requested_name="$2"
			case "$requested_name" in '' | *[!a-zA-Z0-9_-]*) die "invalid sandbox alias" ;; esac
			shift 2
			;;
		--arg)
			# The contract's name=value is sbx's own --kit-arg spelling,
			# which applies the value to every kit that declares the
			# argument.
			kit_args+=("--kit-arg" "$2")
			shift 2
			;;
		--env)
			container_env_args+=("--env" "$2")
			shift 2
			;;
		--skills-host-store)
			skills_store_scenario="$2"
			shift 2
			;;
		--skills-host-mode)
			skills_mode="$2"
			shift 2
			;;
		--ssh-agent)
			# The suite's agent socket becomes the client socket sbx
			# forwards into the sandbox. Remembered for recreate: the
			# contract does not re-pass create options on that verb.
			ssh_agent="$2"
			shift 2
			;;
		--ssh-known-hosts)
			ssh_known_hosts="$2"
			shift 2
			;;
		--git-identity-config)
			git_identity_config="$2"
			shift 2
			;;
		--reject-capability)
			# False selection answer for this create. Must not fall
			# through as a kit reference: Adapter.Create appends these
			# after the kit list.
			rejects+=("$2")
			shift 2
			;;
		*)
			kits+=("$1")
			shift
			;;
		esac
	done
	[ "${#kits[@]}" -gt 0 ] || die "create needs at least one kit reference"

	# §2.3: an adapter claiming agent-skills@1 must default the host's
	# setting to its most permissive value, because access is the
	# narrower of the host's setting and the kit's — a restrictive
	# default would leave the kit's half unobservable. sbx defaults to
	# readonly (or skills.defaultMode), so the default is stated here
	# rather than inherited.
	[ -n "$skills_mode" ] || skills_mode="readwrite"

	refuse_rejected_required "${kits[@]}"
	check_prerequisites
	prepare_skill_store "$skills_store_scenario"
	bind_credential

	id="${requested_name:-$(new_id)}"
	# Snapshot identity before argv is remembered so recreate replays the
	# pinned pair, not later suite edits to the mutable config path.
	# Keep the snapshot even when create rejects the grant: a later
	# selection-policy that clears rejections must be able to restore it
	# via filter_argv_for_rejects, which withholds --git-identity-config
	# only while the rejection is active.
	git_identity_config="$(snapshot_git_identity "$id" "$git_identity_config")"
	# Remember the full create shape (every mixin, identity snapshot, known
	# hosts) so a later selection-policy that clears rejections can restore
	# grants. filter_argv_for_rejects applies the active policy at create
	# and again at recreate.
	remembered_argv=(create --name "$id" --quiet --skills "$skills_mode" --pull missing "$(kit_reference "${kits[0]}")")
	for kit in "${kits[@]:1}"; do
		remembered_argv+=(--kit "$(kit_reference "$kit")")
	done
	remembered_argv+=(${kit_args[@]+"${kit_args[@]}"})
	remembered_argv+=(${container_env_args[@]+"${container_env_args[@]}"})
	# Contract options sbx accepts under the same names once the runtime
	# claim is live. Absent options stay absent: an empty --ssh-agent
	# would invent a socket, and withholding identity is `off`, not an
	# omitted flag.
	[ -z "$ssh_known_hosts" ] || remembered_argv+=(--ssh-known-hosts "$ssh_known_hosts")
	[ -z "$git_identity_config" ] || remembered_argv+=(--git-identity-config "$git_identity_config")
	printf '%s\0' "${remembered_argv[@]}" >"$state/$id.create"
	# Kits and host skills inputs are remembered so recreate can select
	# afresh under selection-policy without re-parsing sbx's argv.
	printf '%s\0' "${kits[@]}" >"$state/$id.kits"
	printf '%s\n' "$skills_mode" >"$state/$id.skills-mode"
	printf '%s\n' "$skills_store_scenario" >"$state/$id.skills-store"
	# Initial rejects are create-time only; selection-policy replaces them
	# for the next recreate (empty clears).
	: >"$state/$id.selection-policy"
	argv=()
	while IFS= read -r -d '' arg; do argv+=("$arg"); done < <(filter_argv_for_rejects "${remembered_argv[@]}")
	# The suite's agent is the only backing agent this create may use.
	# Without --ssh-agent, clear SSH_AUTH_SOCK so a host agent of the
	# operator's is not silently substituted (§2.3). A rejected grant
	# likewise clears the socket even when the suite offered one.
	if [ -n "$ssh_agent" ]; then
		printf '%s\n' "$ssh_agent" >"$state/$id.ssh-agent"
	else
		rm -f "$state/$id.ssh-agent"
	fi
	if [ -n "$ssh_agent" ] && ! rejected_capability com.docker.sandbox/ssh-agent@1; then
		SSH_AUTH_SOCK="$ssh_agent" create_sandbox "$id" "${argv[@]}"
	else
		(unset SSH_AUTH_SOCK; create_sandbox "$id" "${argv[@]}")
	fi
	# create_sandbox exits on failure; reaching here means the sandbox
	# exists and the create-time selection can be retained.
	retain_selection "$id" "$git_identity_config" "$skills_mode" "$skills_store_scenario" "$ssh_agent" "${kits[@]}"
	;;

exec)
	id="$1"
	shift
	[ "${1:-}" = "--" ] && shift
	# The argv passes through unmodified and the status proxies back:
	# checks compare bytes and read exit codes, so neither may be
	# rewritten here. sbx allocates no TTY unless asked, which is what
	# the contract requires.
	set +e
	run_sbx exec "$id" "$@"
	status=$?
	set -e
	exit "$status"
	;;

stop)
	run_sbx stop "$1" >&2
	;;

start)
	# `sbx run` is how a stopped sandbox comes back; --detached starts it
	# and returns instead of opening an agent session, and the name alone
	# identifies it — the kit set comes from the sandbox's own spec.
	run_sbx run --name "$1" --detached >&2
	;;

volume-paths)
	if claims_volume; then
		die "sbx does not expose retained instance volume storage"
	fi
	printf '[]\n'
	;;

recreate)
	# Refuse before removal: replaying an alias is not preserving the
	# instance required by volume@1, even if a backend kept some data.
	if claims_volume; then
		die "sbx cannot recreate instance-owned volumes without removing the instance"
	fi
	[ "$#" -eq 1 ] || die "sbx adapter does not support changed-composition recreation"
	# Only the verbs that keep records need one.
	prepare_state
	id="$1"
	[ -f "$state/$id.create" ] ||
		die "no create arguments remembered for $id; recreate needs the composition the sandbox was made from"
	# sbx has no verb that replaces a sandbox's container in place, so
	# this is the two operations that come closest: the writable layer
	# goes with the old sandbox, and the new one is built from the
	# arguments that built the first. Anything the runtime keeps across
	# it, it keeps deliberately.
	#
	# The remembered argv already carries the identity snapshot and the
	# suite agent socket is re-exported below: recreate must not reread
	# the mutable --git-identity-config path the suite may have edited.
	kits=()
	if [ -f "$state/$id.kits" ]; then
		while IFS= read -r -d '' kit; do kits+=("$kit"); done <"$state/$id.kits"
	fi
	rejects=()
	if [ -f "$state/$id.selection-policy" ]; then
		while IFS= read -r typ; do
			[ -n "$typ" ] && rejects+=("$typ")
		done <"$state/$id.selection-policy"
	fi
	refuse_rejected_required "${kits[@]+"${kits[@]}"}"
	run_sbx rm --force "$id" >&2
	remembered_argv=()
	while IFS= read -r -d '' arg; do remembered_argv+=("$arg"); done <"$state/$id.create"
	argv=()
	while IFS= read -r -d '' arg; do argv+=("$arg"); done < <(filter_argv_for_rejects "${remembered_argv[@]+"${remembered_argv[@]}"}")
	# Replay the original create's agent binding: the suite may have
	# changed the host's SSH_AUTH_SOCK since, and recreate must still
	# point at the agent the first create was judged against — unless the
	# current selection-policy rejects ssh-agent@1.
	if [ -f "$state/$id.ssh-agent" ] && ! rejected_capability com.docker.sandbox/ssh-agent@1; then
		SSH_AUTH_SOCK="$(cat "$state/$id.ssh-agent")" create_sandbox "$id" "${argv[@]}" >/dev/null
	else
		(unset SSH_AUTH_SOCK; create_sandbox "$id" "${argv[@]}" >/dev/null)
	fi
	# Recreate selects afresh under the current selection-policy.
	if [ "${#kits[@]}" -gt 0 ]; then
		identity_for_selection=""
		if ! rejected_capability com.docker.sandbox/git-identity@1; then
			identity_for_selection="$(cat "$state/$id.git-identity-config" 2>/dev/null || true)"
		fi
		# Offered suite socket (may be withheld from sbx when rejected).
		ssh_for_selection="$(cat "$state/$id.ssh-agent" 2>/dev/null || true)"
		retain_selection "$id" \
			"$identity_for_selection" \
			"$(cat "$state/$id.skills-mode" 2>/dev/null || true)" \
			"$(cat "$state/$id.skills-store" 2>/dev/null || true)" \
			"$ssh_for_selection" \
			"${kits[@]}"
	fi
	;;

selection)
	prepare_state
	[ -f "$state/$1.selection.json" ] ||
		die "no selection retained for $1; create must succeed before selection is observed"
	cat "$state/$1.selection.json"
	;;

selection-policy)
	# Remembered for the next recreate. Stop/start keep the current
	# grants; only recreate consults this file. Empty clears rejections.
	prepare_state
	id="$1"
	shift || true
	: >"$state/$id.selection-policy"
	while [ $# -gt 0 ]; do
		case "$1" in
		--reject-capability)
			printf '%s\n' "$2" >>"$state/$id.selection-policy"
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	;;

rm)
	# Only the verbs that keep records need one.
	prepare_state
	id="$1"
	# --force because the contract forbids interactive input, and the
	# suite removes sandboxes that may still be in use.
	set +e
	run_sbx rm --force "$id" >&2
	status=$?
	set -e
	# A sandbox the daemon does not list is gone whatever the removal
	# said: a recreate whose fresh create failed leaves the suite asking
	# for an id that no longer exists, and that is cleaned up rather than
	# leaked. Still there, or a daemon that cannot say, keeps both the
	# bookkeeping and what the adapter seeded — this is not the last
	# sandbox until it is gone.
	if [ "$status" -ne 0 ] && ! absent "$id"; then
		exit "$status"
	fi
	rm -f "$state/$id.create" "$state/$id.ssh-agent" \
		"$state/$id.kits" "$state/$id.git-identity-config" \
		"$state/$id.git-identity-snapshot" \
		"$state/$id.skills-mode" "$state/$id.skills-store" \
		"$state/$id.selection.json" "$state/$id.selection-policy"
	# What the adapter arranged on the host goes with the last sandbox it
	# holds: nothing is left to read the store, and leaving it would grow
	# a user's store by an entry per run.
	release_host_state
	exit 0
	;;

version | --version | -version)
	echo "sbx-adapter for $(run_sbx version 2>&1 | head -1)"
	;;

*)
	# Not exit 2: an unknown verb is this adapter failing to understand
	# the suite, not the runtime declining something it understood.
	die "unknown verb ${verb:-<none>}"
	;;
esac
