# Repository history and local editor/agent settings
.git
**/.git
.vscode
**/.vscode
.claude
**/.claude
**/.DS_Store

# Local build and release artifacts
/frontend
/kit-tck
/bin
/dist
node_modules

# Local secrets and credentials — this project has none checked in, but
# excluded defensively so a local .env or key never lands in a build context
.env
.env.*
*.key
*.pem
secrets/
*.log

# Optional local workspace; published builds use independent modules.
/go.work
/go.work.sum
