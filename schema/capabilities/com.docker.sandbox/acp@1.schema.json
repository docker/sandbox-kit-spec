{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "com.docker.sandbox/acp@1",
  "description": "How to start an agent ACP stdio adapter inside the sandbox. Instance-shaped, keyed on the normalized agent provides name; workloads and mixins may declare it. Grants no permission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "command"
  ],
  "properties": {
    "agent": {
      "description": "Unversioned provides name of the agent this adapter fronts. Bare names normalize into com.docker.kit.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:(?:deb|apk|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)/)?[a-z0-9]([a-z0-9+.-]{0,62}[a-z0-9+])?$",
          "not": {
            "pattern": "^[^/]{254,}/"
          }
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
        }
      ]
    },
    "command": {
      "description": "Complete command speaking ACP on stdio, without a TTY. A string runs via sh -c; a list supplies exec argv.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S",
          "not": {
            "pattern": "\u0000"
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": [
            {
              "type": "string",
              "pattern": "\\S",
              "not": {
                "pattern": "\u0000"
              }
            }
          ],
          "additionalItems": {
            "type": "string",
            "not": {
              "pattern": "\u0000"
            }
          }
        }
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "not": {
          "pattern": "\u0000"
        }
      },
      "description": "Extra environment for this adapter process, overlaid on the agent session environment."
    },
    "protocolVersion": {
      "description": "Positive ACP major version, not a minimum; initialize still negotiates.",
      "default": 1,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
        }
      ]
    }
  }
}
