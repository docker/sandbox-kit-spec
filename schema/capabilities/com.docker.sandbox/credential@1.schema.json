{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "com.docker.sandbox/credential@1",
  "description": "Config schema for one credential need: a service the workload authenticates to and how the proxy presents proof \u2014 never where the secret lives. Phase-scoped like network: an install-only credential is injected only while install runs and is gone before the workload starts; an entry declaring both install and runtime uses the same configuration in both phases. Instance-shaped, keyed by (service, phase) for each declared phase. The @1 names the capability contract, including this config schema and observable behavior. RELEASES.md defines when versions move and the maintainer-approved draft-stage exception.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "phase"
  ],
  "properties": {
    "service": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
        }
      ],
      "description": "Identifier in the host credential store. May embed ${{ kit.args.* }}."
    },
    "phase": {
      "anyOf": [
        {
          "anyOf": [
            {
              "enum": [
                "install",
                "runtime"
              ]
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
            }
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "enum": [
                  "install",
                  "runtime"
                ]
              },
              {
                "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
              }
            ]
          }
        }
      ]
    },
    "apiKey": {
      "$ref": "#/definitions/apiKey"
    },
    "oauth": {
      "$ref": "#/definitions/oauth"
    }
  },
  "anyOf": [
    {
      "required": [
        "apiKey"
      ]
    },
    {
      "required": [
        "oauth"
      ]
    }
  ],
  "definitions": {
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ]
            }
          }
        },
        {
          "required": [
            "inject"
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "pattern": "^$"
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ]
            },
            "inject": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
            }
          ],
          "description": "In-container env var, set to a sentinel when proxy-managed. Empty or omitted with inject rules present means inject-only: no environment presence at all."
        },
        "proxyManaged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
            }
          ],
          "description": "Keeps the real value on the host. A named key's variable carries a sentinel; an inject-only key has no in-container presence, and the boundary presents the real value outbound either way."
        },
        "inject": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/inject"
          },
          "description": "Outbound domains the proxy rewrites. Every domain must appear in the matching phase of the network policy's allow list (or be covered by a bare wildcard)."
        }
      }
    },
    "inject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "description": "Renders the credential into the header value, e.g. \"Bearer %s\"."
        },
        "scheme": {
          "type": "string",
          "description": "Non-header presentation, e.g. \"basic\"."
        },
        "username": {
          "type": "string",
          "description": "Basic-auth username when scheme is \"basic\"."
        }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "resourceHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentinels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessToken": {
              "type": "string"
            },
            "refreshToken": {
              "type": "string"
            }
          }
        },
        "credentialFile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "structure": {
              "type": "object",
              "description": "Declarative nested map, encoded after placeholder substitution in the encoding `format` selects. Leaf strings may reference {{.AccessToken}} and {{.RefreshToken}} (strings), {{.ExpiresAt}} (a number), {{.Scopes}} (an array), and {{.PrimaryApiKey}} (a string whose enclosing key is omitted when no key is captured). OpenAI also supports {{.IDToken}} (signature-masked JWT), {{.AccountID}} (ChatGPT account ID), and {{.LastRefresh}} (RFC 3339)."
            },
            "format": {
              "anyOf": [
                {
                  "enum": [
                    "json",
                    "toml"
                  ]
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ],
              "description": "Encoding of the substituted structure. Defaults to json; toml serves agents that read TOML credential files, with nested maps becoming tables."
            }
          },
          "if": {
            "properties": {
              "format": {
                "const": "toml"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "structure": {
                "additionalProperties": {
                  "$ref": "#/definitions/tomlValue"
                }
              }
            }
          }
        },
        "responseFields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessToken": {
              "type": "string"
            },
            "refreshToken": {
              "type": "string"
            },
            "expiresIn": {
              "type": "string"
            }
          }
        },
        "passthrough": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
            }
          ],
          "description": "Returns the real token to the container: a downgrade."
        }
      }
    },
    "tomlValue": {
      "description": "A value TOML 1.0 can represent: null has no TOML spelling, so it is rejected wherever it nests when format is toml. Mixed-type arrays are legal TOML 1.0 and deliberately not judged.",
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "object"
      ],
      "items": {
        "$ref": "#/definitions/tomlValue"
      },
      "additionalProperties": {
        "$ref": "#/definitions/tomlValue"
      }
    }
  }
}
