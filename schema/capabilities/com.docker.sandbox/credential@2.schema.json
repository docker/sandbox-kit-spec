{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "com.docker.sandbox/credential@2",
  "description": "A phase-scoped service credential with explicit missing-binding policy and an opt-in native OpenAI ChatGPT identity profile. The host credential store remains the sole source of credentials. Credential versions share ownership of each (service, phase).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "phase"
  ],
  "properties": {
    "service": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
        }
      ],
      "description": "Identifier in the host credential store. May embed ${{ kit.args.* }}."
    },
    "phase": {
      "anyOf": [
        {
          "anyOf": [
            {
              "enum": [
                "install",
                "runtime"
              ]
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
            }
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "enum": [
                  "install",
                  "runtime"
                ]
              },
              {
                "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
              }
            ]
          }
        }
      ]
    },
    "apiKey": {
      "$ref": "#/definitions/apiKey"
    },
    "oauth": {
      "$ref": "#/definitions/oauth"
    },
    "onMissing": {
      "anyOf": [
        {
          "enum": [
            "error",
            "unauthenticated"
          ]
        },
        {
          "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
        }
      ],
      "default": "error",
      "description": "Behavior when the service has no host binding. Defaults to error independently of entry optionality; unauthenticated starts without this credential presentation."
    }
  },
  "anyOf": [
    {
      "required": [
        "apiKey"
      ]
    },
    {
      "required": [
        "oauth"
      ]
    }
  ],
  "definitions": {
    "apiKey": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ]
            }
          }
        },
        {
          "required": [
            "inject"
          ],
          "properties": {
            "name": {
              "anyOf": [
                {
                  "pattern": "^$"
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ]
            },
            "inject": {
              "minItems": 1
            }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "anyOf": [
            {
              "pattern": "^([A-Za-z_][A-Za-z0-9_]*)?$"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
            }
          ],
          "description": "In-container env var, set to a sentinel when proxy-managed. Empty or omitted with inject rules present means inject-only: no environment presence at all."
        },
        "proxyManaged": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
            }
          ],
          "description": "Keeps the real value on the host. A named key's variable carries a sentinel; an inject-only key has no in-container presence, and the boundary presents the real value outbound either way."
        },
        "inject": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/inject"
          },
          "description": "Outbound domains the proxy rewrites. Every domain must appear in the matching phase of the network policy's allow list (or be covered by a bare wildcard)."
        }
      }
    },
    "inject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "header": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "description": "Renders the credential into the header value, e.g. \"Bearer %s\"."
        },
        "scheme": {
          "type": "string",
          "description": "Non-header presentation, e.g. \"basic\"."
        },
        "username": {
          "type": "string",
          "description": "Basic-auth username when scheme is \"basic\"."
        }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokenEndpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host"
          ],
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "resourceHosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sentinels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessToken": {
              "type": "string"
            },
            "refreshToken": {
              "type": "string"
            }
          }
        },
        "credentialFile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "structure": {
              "type": "object",
              "description": "Declarative nested map encoded after typed placeholder substitution. Generic OAuth supports {{.AccessToken}}, {{.RefreshToken}}, {{.ExpiresAt}}, {{.Scopes}}, and {{.PrimaryApiKey}}. The openai-chatgpt profile supports {{.IDToken}}, {{.AccessToken}}, {{.RefreshToken}}, {{.AccountID}}, and {{.LastRefresh}}; these values contain no usable provider credentials."
            },
            "format": {
              "anyOf": [
                {
                  "enum": [
                    "json",
                    "toml"
                  ]
                },
                {
                  "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                }
              ],
              "description": "Encoding of the substituted structure. Defaults to json; toml serves agents that read TOML credential files, with nested maps becoming tables."
            }
          },
          "if": {
            "properties": {
              "format": {
                "const": "toml"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "structure": {
                "additionalProperties": {
                  "$ref": "#/definitions/tomlValue"
                }
              }
            }
          }
        },
        "responseFields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessToken": {
              "type": "string"
            },
            "refreshToken": {
              "type": "string"
            },
            "expiresIn": {
              "type": "string"
            }
          }
        },
        "passthrough": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
            }
          ],
          "description": "Returns the real token to the container: a downgrade."
        },
        "profile": {
          "anyOf": [
            {
              "enum": [
                "openai-chatgpt"
              ]
            },
            {
              "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
            }
          ],
          "description": "Opt-in native identity presentation. Omit for generic OAuth; profile support is part of credential@2 support."
        }
      },
      "if": {
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "const": "openai-chatgpt"
          }
        }
      },
      "then": {
        "required": [
          "tokenEndpoint",
          "sentinels"
        ],
        "properties": {
          "tokenEndpoint": {
            "required": [
              "host",
              "path"
            ],
            "properties": {
              "host": {
                "anyOf": [
                  {
                    "const": "auth.openai.com"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              },
              "path": {
                "anyOf": [
                  {
                    "const": "/oauth/token"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              }
            }
          },
          "sentinels": {
            "required": [
              "accessToken",
              "refreshToken"
            ],
            "properties": {
              "accessToken": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              },
              "refreshToken": {
                "anyOf": [
                  {
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              }
            },
            "description": "Distinct nonempty access and refresh placeholders, containing only ASCII letters, digits, underscores, and hyphens. Their distinction is checked by the reference validator."
          },
          "responseFields": {
            "properties": {
              "accessToken": {
                "anyOf": [
                  {
                    "const": "access_token"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              },
              "refreshToken": {
                "anyOf": [
                  {
                    "const": "refresh_token"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              },
              "expiresIn": {
                "anyOf": [
                  {
                    "const": "expires_in"
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
                  }
                ]
              }
            }
          },
          "passthrough": {
            "anyOf": [
              {
                "const": false
              },
              {
                "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
              }
            ]
          }
        }
      }
    },
    "tomlValue": {
      "description": "A value TOML 1.0 can represent: null has no TOML spelling, so it is rejected wherever it nests when format is toml. Mixed-type arrays are legal TOML 1.0 and deliberately not judged.",
      "type": [
        "string",
        "number",
        "boolean",
        "array",
        "object"
      ],
      "items": {
        "$ref": "#/definitions/tomlValue"
      },
      "additionalProperties": {
        "$ref": "#/definitions/tomlValue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "oauth"
        ],
        "properties": {
          "oauth": {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "const": "openai-chatgpt"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "service": {
            "anyOf": [
              {
                "const": "openai"
              },
              {
                "$ref": "../../definitions/kit-arg.schema.json#/definitions/bearing"
              }
            ]
          },
          "apiKey": {
            "required": [
              "proxyManaged"
            ],
            "properties": {
              "proxyManaged": {
                "anyOf": [
                  {
                    "const": true
                  },
                  {
                    "$ref": "../../definitions/kit-arg.schema.json#/definitions/whole"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
